# 必填：Discord Developer Portal 內的 Bot Token
DISCORD_BOT_TOKEN=

# 必填：先使用 OpenRouter；openrouter/free 會依附圖自動挑選視覺模型
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
# 附圖時使用的模型。維持 openrouter/free 即自動路由；也可改成 OpenRouter 上的 Gemini 模型名稱。
LLM_VISION_MODEL=openrouter/free

# OpenRouter 回傳 402／429 或免費額度用盡時，自動切換至 Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# Discord 文字頻道語音附件備援（沿用上方 GEMINI_API_KEY，不需另一組金鑰）
CLOUD_TTS_ENABLED=true
CLOUD_TTS_MODEL=gemini-3.1-flash-tts-preview
CLOUD_TTS_VOICE=Leda
CLOUD_TTS_MAX_CHARS=900

# /draw 與 /photo 的 Gemini 原生圖片生成（沿用 GEMINI_API_KEY）
CLOUD_IMAGE_MODEL=gemini-3.1-flash-image

# 雲端的 /play 與 /spotify 也控制同一個官方 Spotify Premium 帳號
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# 必填：雲端版只允許這個 Discord 使用者，避免其他人消耗 AI 額度
DISCORD_ALLOWED_USER_IDS=798893182883463179
# 伺服器與頻道可留空；使用者白名單仍會強制套用
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_REQUIRE_MENTION=true

# WutheringWavesUID：GsCore 必須只在同一台主機／私人網路開啟 HTTP 介面
GSCORE_HTTP_URL=http://127.0.0.1:8765

# 崩壞：星穹鐵道 HoYoLAB 雲端每日簽到（App 關閉、雲端接管時仍會執行）
# Cookie 是登入憑證，只能放在 VM 上權限 600 的 .env，禁止提交到 Git 或貼到 Discord。
HSR_DAILY_ENABLED=false
HSR_DAILY_UID=
HSR_DAILY_COOKIE=
HSR_DAILY_USER_ID=798893182883463179
# 留空會改用上方使用者的 Discord 私訊；填寫則傳到指定頻道。
HSR_DAILY_CHANNEL_ID=
HSR_DAILY_HOUR=8
HSR_DAILY_TIME_ZONE=Asia/Taipei

# 雲端服務設定
DATA_DIR=/data
PORT=3000
HISTORY_MESSAGES=8
MAX_OUTPUT_TOKENS=1000
BOT_ACTIVITY=在雲端守望永晝花庭
CLOUD_MUSIC_MONTHLY_MINUTES=0
CLOUD_ALLOW_MUSIC_AI_REQUESTS=true

# 設為 CLOUD_ALLOW_MUSIC_AI_REQUESTS=true 可讓雲端聊天回應音樂搜尋／推薦／分析請求。
# CLOUD_MUSIC_MONTHLY_MINUTES=0 代表不限制每月雲端音樂播放分鐘數。
# 桌面版優先使用原本的 GPT-SoVITS；桌面離線時，雲端可用 Gemini TTS 回傳 Discord 語音附件。
# Spotify/Bilibili 搜尋與其他媒體處理仍只留在桌面版；圖片可由 OpenRouter 視覺模型直接辨識。
